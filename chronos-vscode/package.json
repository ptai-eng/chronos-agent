{
  "name": "chronos-agent",
  "displayName": "CHRONOS Agent",
  "description": "4D Living Code Intelligence Harness — Real-time blast-radius + mutation score",
  "version": "1.4.0",
  "publisher": "ptai-eng",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "mcp",
    "ai",
    "blast-radius",
    "telemetry",
    "kuzu",
    "mutation-testing",
    "chronos"
  ],
  "homepage": "https://github.com/ptai-eng/chronos-agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/ptai-eng/chronos-agent.git"
  },
  "bugs": {
    "url": "https://github.com/ptai-eng/chronos-agent/issues"
  },
  "license": "MIT",
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:python",
    "onLanguage:rust",
    "onLanguage:go",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:java"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "chronos.analyze",
        "title": "CHRONOS: Analyze File"
      },
      {
        "command": "chronos.showHotspots",
        "title": "CHRONOS: Show Hotspots"
      },
      {
        "command": "chronos.blastRadius",
        "title": "CHRONOS: Blast Radius"
      }
    ],
    "configuration": {
      "title": "CHRONOS",
      "properties": {
        "chronos.mcpBinaryPath": {
          "type": "string",
          "description": "Path to chronos-mcp executable binary"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0",
    "vscode-languageclient": "^10.1.0"
  },
  "dependencies": {
    "axios": "^1.19.0"
  }
}
