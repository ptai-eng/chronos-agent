{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "chronos hook post-edit --workspace . --client claude",
            "type": "command"
          }
        ],
        "matcher": "Edit|MultiEdit|Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "chronos hook session-start --workspace . --client claude",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__chronos-agent__*"
    ]
  }
}
